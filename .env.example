# ==============================================================================
# CAREERLY (OPPORTUNITY FINDER) — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your environment-specific values.
# NEVER commit the actual .env file with real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION & NETWORKING
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100,http://localhost:5173
TRUST_PROXY=false

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (MANDATORY IN PRODUCTION)
# ------------------------------------------------------------------------------
# Minimum 32-character random string for signing JSON Web Tokens
JWT_SECRET=your_super_secret_jwt_signing_key_minimum_32_characters
ADMIN_EMAIL=ayarianas79@gmail.com
RATE_LIMIT_AUTH_MAX=20

# ------------------------------------------------------------------------------
# 3. AI INTELLIGENCE (GOOGLE GEMINI)
# ------------------------------------------------------------------------------
# Server-side Gemini API key for ATS resume analysis, Mock Interview, Copilot
GEMINI_API_KEY=your_gemini_api_key_here
# Optional fallback for client-side AI simulations
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 4. EXTERNAL DATA INGESTION & DISCOVERY
# ------------------------------------------------------------------------------
# Serper.dev Google Jobs API key for live opportunity indexing
SERPER_API_KEY=your_serper_api_key_here
# Optional Composio API key for tool integrations
COMPOSIO_API_KEY=your_composio_api_key_here
# Set to 'true' to disable automatic background scraping in development
DISABLE_AUTO_SCRAPE=false

# ------------------------------------------------------------------------------
# 5. DATABASE & CLOUD SYNCHRONIZATION (SUPABASE)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# ------------------------------------------------------------------------------
# 6. EMAIL NOTIFICATIONS & DISPATCH (SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_google_app_password_here
SMTP_SECURE=true
MUTE_TEST_EMAILS=false

# ------------------------------------------------------------------------------
# 7. SECURITY INCIDENT ALERTING & TELEMETRY
# ------------------------------------------------------------------------------
SECURITY_ALERT_EMAIL_ENABLED=false
SECURITY_ALERT_EMAIL_TO=ayarianas79@gmail.com
SECURITY_ALERT_SLACK_ENABLED=false
SECURITY_ALERT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
SECURITY_ALERT_WEBHOOK_ENABLED=false
SECURITY_ALERT_WEBHOOK_URL=https://your-security-webhook.endpoint/api

# ------------------------------------------------------------------------------
# 8. FRONTEND CLIENT CONFIGURATION (Vite 'VITE_' Prefixed)
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Client ID for Frontend Sign-In
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
# Sentry Frontend Error Monitoring DSN
VITE_SENTRY_DSN=your_sentry_client_dsn_here
# Custom API base URL for standalone frontend deployments (defaults to relative /api)
# VITE_API_URL=http://localhost:5000

ELEVENLABS_API_KEY=sk_72ba922ee0c8b54fee37611c8e445e7d593bfe53ab541b48

VITE_ELEVENLABS_API_KEY=sk_72ba922ee0c8b54fee37611c8e445e7d593bfe53ab541b48
